{
  "name": "vink-zapier",
  "version": "1.0.0",
  "description": "Vink on Zapier: a trigger for approved Submissions and an action that sends a PDF in.",
  "private": true,
  "main": "index.js",
  "scripts": {
    "test": "jest --testTimeout 10000",
    "validate": "zapier validate"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "form-data": "^4.0.6",
    "zapier-platform-core": "19.1.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nock": "^14.0.17"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  }
}
