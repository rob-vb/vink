{
    "url": "https://vink.page/v1/subscriptions",
    "method": "POST",
    "headers": {
        "authorization": "Bearer {{connection.apiKey}}"
    },
    "type": "json",
    "body": {
        "form_id": "{{parameters.form_id}}",
        "url": "{{webhook.url}}"
    },
    "response": {
        "data": {
            "externalHookId": "{{body.id}}",
            "formId": "{{body.form_id}}"
        },
        "error": {
            "message": "[{{statusCode}}] {{ifempty(body.error.message, 'Vink answered without an error message.')}}{{if(body.error.code, ' (error code: ' + body.error.code + ')', '')}}"
        }
    },
    "log": {
        "sanitize": ["request.headers.authorization"]
    }
}
