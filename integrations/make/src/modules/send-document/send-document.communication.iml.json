{
    "url": "/forms/{{parameters.form_id}}/documents",
    "method": "POST",
    "type": "multipart/form-data",
    "body": {
        "file": {
            "value": "{{parameters.file_data}}",
            "options": {
                "filename": "{{parameters.file_name}}",
                "contentType": "application/pdf"
            }
        }
    },
    "response": {
        "output": "{{body}}"
    }
}
