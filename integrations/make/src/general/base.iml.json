{
    "baseUrl": "https://vink.page/v1",
    "headers": {
        "authorization": "Bearer {{connection.apiKey}}"
    },
    "response": {
        "error": {
            "message": "[{{statusCode}}] {{ifempty(body.error.message, 'Vink answered without an error message.')}}{{if(body.error.code, ' (error code: ' + body.error.code + ')', '')}}",
            "401": {
                "type": "InvalidAccessTokenError"
            },
            "413": {
                "type": "DataError"
            },
            "415": {
                "type": "DataError"
            },
            "422": {
                "type": "DataError"
            }
        }
    },
    "log": {
        "sanitize": ["request.headers.authorization"]
    }
}
